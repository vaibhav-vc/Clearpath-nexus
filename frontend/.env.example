# Use a same-origin reverse proxy locally, or an HTTPS API domain in Vercel.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
# Local-only, explicit development demo. Keep false for a real Supabase deployment.
VITE_LOCAL_DEMO_MODE=false
