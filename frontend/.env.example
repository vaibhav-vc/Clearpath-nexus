# Use a same-origin reverse proxy locally, or an HTTPS API domain in Vercel.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key
# Local-only, explicit development demo. Keep false for a real Supabase deployment.
VITE_LOCAL_DEMO_MODE=false
# Deployment-tunable defaults; each falls back to the value shown.
VITE_DEFAULT_ORIGIN=NGP
VITE_DEFAULT_DESTINATION=JNPT
VITE_MAP_CENTER_LAT=21.1458
VITE_MAP_CENTER_LON=79.0882
VITE_MAP_DEFAULT_ZOOM=6
VITE_MAP_ZONE_RADIUS_M=12000
VITE_MAP_CONDITION_RADIUS_M=5000
VITE_LIVEOPS_REFRESH_MS=15000
