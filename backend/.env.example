# CLEARPATH NEXUS CORE SERVICE ENGINE CONFIGURATION

ENVIRONMENT=development
DEBUG=False
SECRET_KEY=replace_with_a_random_32_character_secret
PROJECT_NAME="ClearPath Nexus Engine"

# Supabase is the single identity provider for web and Android.
SUPABASE_URL=https://your-project.supabase.co
# Only needed for legacy HS256 Supabase projects; modern projects use JWKS.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
AUTH_DISABLED=false

POSTGRES_USER=nexus_admin
POSTGRES_PASSWORD=replace_with_a_database_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clearpath_nexus_db
DATABASE_URL=postgresql+asyncpg://nexus_admin:replace_with_a_database_password@localhost:5432/clearpath_nexus_db

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

OPENWEATHER_API_KEY=
NOAA_SPACE_WEATHER_FEED_URL=https://services.swpc.noaa.gov/products/noaa-planetary-k-index.json
# Required for production route-to-port alignment. Obtain from an authorized provider.
MARITIME_BERTH_DATA_FEED=
AUTH_COOKIE_NAME=clearpath_session
AUTH_REFRESH_COOKIE_NAME=clearpath_refresh
CSRF_COOKIE_NAME=clearpath_csrf
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
DEMO_DATA_ENABLED=true
RAILWAY_OPERATIONS_FEED=
# Optional: free RailRadar sandbox key for a live passenger-train demo layer.
# Not a freight feed, not required — the app runs fine with this unset.
RAILRADAR_API_KEY=
RAILRADAR_CACHE_TTL_SECONDS=7200
RAILRADAR_MONTHLY_BUDGET=900
AISSTREAM_API_KEY=
AIS_COLLECTOR_ENABLED=true
LIVE_CONGESTION_ENABLED=true
LIVE_CONGESTION_WEIGHT=0.6

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

WEIGHT_WEATHER_RISK=0.40
WEIGHT_PORT_ALIGNMENT=0.30
WEIGHT_CORRIDOR_CONGESTION=0.15
WEIGHT_HISTORICAL_DELAY=0.15
